---
import openSource from "@collections/open-source.json";
---

<div class="flex flex-col gap-4">
  {
    openSource.map((item) => {
      return (
        <a
          href={item.url}
          target="_blank"
          class="group relative flex items-center justify-between p-5 border border-dashed rounded-2xl border-neutral-300 dark:border-neutral-600 transition-colors duration-300 hover:border-neutral-400 dark:hover:border-neutral-500"
        >
          <span class="flex items-center gap-3 min-w-0">
            <span
              class="flex-none flex items-center justify-center w-20 px-2 py-0.5 text-[0.65rem] font-semibold uppercase tracking-wide rounded bg-neutral-100 dark:bg-neutral-800 text-neutral-500 dark:text-neutral-400"
            >
              {item.language}
            </span>
            <span class="min-w-0">
              <span
                class="block text-sm font-semibold text-neutral-900 dark:text-neutral-100 truncate"
              >
                {item.name}
              </span>
              <span
                class="block mt-0.5 text-xs leading-5 text-neutral-600 dark:text-neutral-400 line-clamp-2"
              >
                {item.description}
              </span>
            </span>
          </span>
          <span
            class="flex-none flex items-center justify-end gap-1 w-16 ml-4 text-xs text-neutral-500 dark:text-neutral-400"
            title="GitHub Stars"
          >
            <svg
              class="w-3.5 h-3.5"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
              ><path
                fill-rule="evenodd"
                d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.007 5.404.433c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.433 2.082-5.006z"
                clip-rule="evenodd"
              ></path></svg
            >
            {item.stars}
          </span>
        </a>
      )
    })
  }
</div>
