---
import { Image } from "astro:assets";
import avatar from "@assets/images/logo.jpg";
import pay from "@assets/images/pay.jpeg";
import experiences from "@collections/experiences.json";
import AboutExperience from "@components/about-experience.astro";
import AboutOpenSource from "@components/about-open-source.astro";
import AboutSkills from "@components/about-skills.astro";
import Button from "@components/button.astro";
import PageHeading from "@components/page-heading.astro";
import Layout from "@layouts/main.astro";

const contacts = [
  {
    label: "Email",
    value: "me@yansongda.cn",
    url: "mailto:me@yansongda.cn",
    icon: "M2.25 12.76c0 1.6 1.123 2.994 2.707 3.227 1.087.16 2.185.283 3.293.369V21l4.076-4.076a1.526 1.526 0 011.037-.443 48.282 48.282 0 005.68-.494c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z",
  },
  {
    label: "GitHub",
    value: "github.com/yansongda",
    url: "https://github.com/yansongda",
    icon: "M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z",
  },
  {
    label: "博客",
    value: "yansongda.cn",
    url: "https://yansongda.cn",
    icon: "M12 7.5h1.5m-1.5 3h1.5m-7.5 3h7.5m-7.5 3h7.5m3-9h3.375c.621 0 1.125.504 1.125 1.125V18a2.25 2.25 0 01-2.25 2.25M16.5 7.5V18a2.25 2.25 0 002.25 2.25M16.5 7.5V4.875c0-.621-.504-1.125-1.125-1.125H4.125C3.504 3.75 3 4.254 3 4.875V18a2.25 2.25 0 002.25 2.25h13.5M6 7.5h3v3H6v-3z",
  },
];
---

<Layout title="关于我" description="全网最会写支付的 PHP 程序员之一（自封的），最近正蹲在 Rust 的坑里越陷越深 🦀">
  <section class="relative z-20 max-w-2xl mx-auto my-12 px-7 lg:px-0">
    <PageHeading
      title="关于我"
      description="全网最会写支付的 PHP 程序员之一（自封的），最近正蹲在 Rust 的坑里越陷越深 🦀"
    />

    <!-- 个人简介 -->
    <div class="flex flex-col items-center gap-6 mt-8 sm:flex-row">
      <Image
        src={avatar}
        alt="闫嵩达"
        width=120
        class="flex-none w-24 h-24 rounded-full"
      />
      <div class="text-center sm:text-left">
        <h3 class="text-lg font-bold dark:text-neutral-100">闫嵩达</h3>
        <p class="mt-1 text-sm text-neutral-500 dark:text-neutral-400">
          📍 湖北武汉 · 🖥️ 2015 年入行 · 🔧 全淦工程师
        </p>
      </div>
    </div>

    <div
      class="mt-6 space-y-4 text-sm leading-7 text-gray-600 dark:text-neutral-400 sm:text-base sm:leading-8"
    >
      <p>
        一个自称「全淦工程师」的武汉土著，什么都会亿点点，什么都想折腾一遍。写了十年 PHP，顺手把支付库写成了 GitHub
        上最靓的仔（自封 +2）；这两年又一猛子扎进
        Rust，从「这啥呀」到「真香」，目前处于深水区，请勿打扰 🦀。
      </p>
      <p>
        2015 年从物联网数据采集入行，搞过 Modbus TCP、搭过自建 MongoDB 集群、写过微信小程序，也把 Docker 玩出了花。信奉「代码不优雅，人生不完整」，喜欢把复杂的东西做简单。
      </p>
      <p>
        如果你看到我在线，大概率不是在写代码，就是在去写代码的路上 ☕。
      </p>
    </div>

    <!-- 标签 -->
    <h2
      class="mt-5 mb-2 text-2xl font-bold lg:mt-10 sm:mt-6 dark:text-neutral-200"
    >
      标签
    </h2>
    <p
      class="text-sm leading-6 text-gray-600 dark:text-neutral-400 sm:leading-7 lg:leading-8 sm:text-base lg:text-lg"
    >
      后端 cutter 🧑🏻‍💻, 前端 amateur 🤷🏻‍♂️, 持续挖技术坑中 🤦🏻‍♂️
    </p>

    <!-- 技术栈 -->
    <h2
      class="mt-5 mb-2 text-2xl font-bold lg:mt-10 sm:mt-6 dark:text-neutral-200"
    >
      技术栈
    </h2>
    <div class="mt-5">
      <AboutSkills />
    </div>

    <!-- 经历 -->
    <h2
      class="mt-5 mb-2 text-2xl font-bold lg:mt-10 sm:mt-6 dark:text-neutral-200"
    >
      经历
    </h2>
    <div class="px-5 py-10">
      {
        experiences.map((experience) => {
          return (
            <div
              class="pb-10 border-l border-gray-200 last:border-l-0 dark:border-neutral-700"
            >
              <AboutExperience
                dates={experience.dates}
                role={experience.role}
                company={experience.company}
                description={experience.description}
              />
            </div>
          )
        })
      }
    </div>

    <!-- 开源项目 -->
    <h2
      class="mt-5 mb-2 text-2xl font-bold lg:mt-10 sm:mt-6 dark:text-neutral-200"
    >
      开源项目
    </h2>
    <p
      class="mb-5 text-sm leading-6 text-gray-600 dark:text-neutral-400 sm:leading-7 lg:leading-8 sm:text-base lg:text-lg"
    >
      工作之余折腾出来的一些东西，大概都还拿得出手。
    </p>
    <AboutOpenSource />
    <div class="text-center mt-6">
      <Button text="更多项目前往 GitHub" link="https://github.com/yansongda"/>
    </div>

    <!-- 打赏 -->
    <h2
      class="mt-5 mb-2 text-2xl font-bold lg:mt-10 sm:mt-6 dark:text-neutral-200"
    >
      送一杯瑞幸吧
    </h2>
    <p
      class="mb-4 text-sm leading-6 text-gray-600 dark:text-neutral-400 sm:leading-7 lg:leading-8 sm:text-base lg:text-lg"
    >
      如果我的项目对你有帮助，欢迎请我喝一杯瑞幸 ☕，我会更有动力继续折腾！
    </p>
    <div class="flex items-center justify-center">
      <div
        class="p-5 border border-dashed rounded-2xl border-neutral-300 dark:border-neutral-600"
      >
        <Image
          src={pay}
          alt="打赏"
          width=500
        />
      </div>
    </div>

    <!-- 联系我 -->
    <h2
      class="mt-5 mb-2 text-2xl font-bold lg:mt-10 sm:mt-6 dark:text-neutral-200"
    >
      联系我
    </h2>
    <p
      class="mb-5 text-sm leading-6 text-gray-600 dark:text-neutral-400 sm:leading-7 lg:leading-8 sm:text-base lg:text-lg"
    >
      如果你对我感兴趣，可以通过以下方式找到我，我会及时回复。
    </p>
    <div class="flex flex-col gap-3">
      {
        contacts.map((contact) => {
          return (
            <a
              href={contact.url}
              target={contact.url.startsWith("mailto") ? "_self" : "_blank"}
              class="flex items-center gap-3 p-4 border border-dashed rounded-2xl border-neutral-300 dark:border-neutral-600 transition-colors duration-300 hover:border-neutral-400 dark:hover:border-neutral-500"
            >
              <span
                class="flex-none flex items-center justify-center w-8 h-8 rounded-full bg-neutral-100 dark:bg-neutral-800"
              >
                <svg
                  class="w-4 h-4 text-neutral-700 dark:text-neutral-200"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="1.5"
                  stroke="currentColor"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d={contact.icon}
                  ></path></svg
                >
              </span>
              <span class="min-w-0">
                <span
                  class="block text-xs text-neutral-500 dark:text-neutral-400"
                >
                  {contact.label}
                </span>
                <span
                  class="block truncate text-sm font-semibold text-neutral-900 dark:text-neutral-100"
                >
                  {contact.value}
                </span>
              </span>
            </a>
          )
        })
      }
    </div>
  </section>
</Layout>
