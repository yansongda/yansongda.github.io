---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings?: Heading[];
}

const { headings = [] } = Astro.props;

// 清理标题中残留的 markdown 符号（如行内代码的反引号）
const clean = (text: string) => text.replace(/[`*_~]/g, "").trim();

// 仅保留 h2 / h3 作为目录项
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  toc.length > 0 && (
    <>
      <aside
        id="toc-panel"
        class="fixed top-20 right-5 z-40 hidden w-64 max-h-[65vh] overflow-y-auto p-4 bg-white dark:bg-neutral-900 border border-dashed rounded-2xl border-neutral-300 dark:border-neutral-600 shadow-sm lg:block"
        data-toc-panel
      >
        <div class="flex items-center justify-between mb-3">
          <h2
            class="flex items-center gap-1.5 text-sm font-bold text-neutral-900 dark:text-neutral-100"
          >
            <svg
              class="w-4 h-4 text-neutral-500 dark:text-neutral-400"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25H12"
              ></path></svg
            >
            目录
          </h2>
          <button
            id="toc-close"
            type="button"
            aria-label="收起目录"
            class="flex items-center justify-center w-6 h-6 text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white transition-colors"
          >
            <svg
              class="w-4 h-4"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M6 18L18 6M6 6l12 12"
              ></path></svg
            >
          </button>
        </div>

        <nav id="toc-list" class="space-y-0.5" data-toc-list>
          {
            toc.map((h) => {
              return (
                <a
                  href={`#${h.slug}`}
                  data-toc-item
                  data-depth={h.depth}
                  class:list={[
                    "block py-1 pr-2 text-neutral-600 dark:text-neutral-400 rounded hover:text-neutral-900 dark:hover:text-white transition-colors duration-150 truncate",
                    h.depth === 3
                      ? "pl-4 text-xs"
                      : "font-medium text-neutral-800 dark:text-neutral-200 text-[0.8rem]",
                  ]}
                >
                  {clean(h.text)}
                </a>
              )
            })
          }
        </nav>
      </aside>

      <button
        id="toc-toggle"
        type="button"
        aria-label="展开目录"
        class="fixed top-20 right-5 z-40 hidden w-11 h-11 items-center justify-center bg-white dark:bg-neutral-900 border border-dashed rounded-full border-neutral-300 dark:border-neutral-600 shadow-sm text-neutral-700 dark:text-neutral-300 hover:border-neutral-400 dark:hover:border-neutral-500 transition-colors"
        data-toc-toggle
      >
        <svg
          class="w-5 h-5"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25H12"
          ></path></svg
        >
      </button>
    </>
  )
}
