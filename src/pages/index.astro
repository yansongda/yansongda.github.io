---
import { Image } from "astro:assets";
import avatar from "@assets/images/logo.jpg";
import Button from "@components/button.astro";
import Projects from "@components/home/projects.astro";
import Separator from "@components/home/separator.astro";
import Writings from "@components/home/writings.astro";
import Layout from "@layouts/main.astro";
---

<Layout title="闫嵩达" description="闫嵩达的个人主页：全淦工程师，Pay 支付 SDK 维护者，正在 Rust 深水区挣扎 🦀">
  <div
    class="relative z-20 w-full max-w-4xl mx-auto mt-16 px-7 md:mt-24 lg:mt-32 xl:px-0"
  >
    <div class="flex flex-col items-center md:flex-row">
      <div class="relative w-full">
        <h1
          class="mb-5 text-4xl font-bold leading-tight lg:text-6xl lg:leading-tight dark:text-white"
        >
          <span
            class="text-transparent bg-clip-text bg-[length:300%]"
            style="background-image: linear-gradient(to right, rgb(194, 65, 12), rgb(59, 130, 246), rgb(74, 222, 128)); animation: animatedgradient 6s ease infinite alternate;"
          >
            Coding My Life...
          </span>
        </h1>
        <p class="mb-6 text-base text-neutral-600 dark:text-neutral-400">
          <span 
            data-typed='["你好，我是闫嵩达", "全网最会写支付的 PHP 程序员（自封）", "正在 Rust 深水区挣扎中", "全淦工程师", "持续挖坑，敬请期待"]'
            data-type-speed="100"
            data-delete-speed="50"
            data-pause-duration="2000"
          ></span>
        </p>
        <div class="flex flex-wrap items-center gap-3">
          <Button text="Follow me on Github" link="https://github.com/yansongda"/>
          <Button text="关于我" link="/about" target="_self"/>
        </div>
        <div class="flex flex-wrap gap-2 mt-3">
          <a
            href="https://github.com/yansongda/pay"
            target="_blank"
            class="inline-flex items-center gap-1 px-3 py-1 text-xs font-semibold border border-dashed rounded-full border-neutral-300 dark:border-neutral-600 text-neutral-700 dark:text-neutral-300 transition-colors duration-300 hover:border-neutral-400 dark:hover:border-neutral-500"
          >
            <svg class="w-3 h-3" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.007 5.404.433c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.433 2.082-5.006z" clip-rule="evenodd"></path></svg>
            pay · 5.3k★
          </a>
          <a
            href="https://github.com/yansongda/laravel-pay"
            target="_blank"
            class="inline-flex items-center gap-1 px-3 py-1 text-xs font-semibold border border-dashed rounded-full border-neutral-300 dark:border-neutral-600 text-neutral-700 dark:text-neutral-300 transition-colors duration-300 hover:border-neutral-400 dark:hover:border-neutral-500"
          >
            <svg class="w-3 h-3" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.007 5.404.433c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.433 2.082-5.006z" clip-rule="evenodd"></path></svg>
            laravel-pay · 1.1k★
          </a>
          <a
            href="https://github.com/yansongda?tab=repositories"
            target="_blank"
            class="inline-flex items-center gap-1 px-3 py-1 text-xs font-semibold border border-dashed rounded-full border-neutral-300 dark:border-neutral-600 text-neutral-700 dark:text-neutral-300 transition-colors duration-300 hover:border-neutral-400 dark:hover:border-neutral-500"
          >
            <svg class="w-3 h-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12.75V12A2.25 2.25 0 014.5 9.75h15A2.25 2.25 0 0121.75 12v.75m-8.69-6.44l-2.12-2.12a1.5 1.5 0 00-1.061-.44H4.5A2.25 2.25 0 002.25 6v12a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9a2.25 2.25 0 00-2.25-2.25h-5.379a1.5 1.5 0 01-1.06-.44z"></path></svg>
            31 repos
          </a>
        </div>
      </div>
      <div
        class="relative justify-end hidden w-full mt-10 md:flex md:pl-10 md:w-1/2 md:mt-0 md:translate-y-4 xl:translate-y-0"
      >
        <div class="relative z-30">
          <Image
            src={avatar}
            alt="Yan Songda"
            width=500
          />
        </div>
      </div>
    </div>
  </div>

  <div
    class="relative z-20 grid w-full max-w-4xl grid-cols-2 gap-4 mx-auto px-7 mt-14 sm:grid-cols-4 xl:px-0"
  >
    <div
      class="p-4 text-center border border-dashed rounded-2xl border-neutral-300 dark:border-neutral-600"
    >
      <div class="text-2xl font-bold text-neutral-900 dark:text-neutral-100">
        10年+
      </div>
      <div class="mt-1 text-xs text-neutral-500 dark:text-neutral-400">
        工程经验
      </div>
    </div>
    <div
      class="p-4 text-center border border-dashed rounded-2xl border-neutral-300 dark:border-neutral-600"
    >
      <div class="text-2xl font-bold text-neutral-900 dark:text-neutral-100">
        49
      </div>
      <div class="mt-1 text-xs text-neutral-500 dark:text-neutral-400">
        篇文章
      </div>
    </div>
    <div
      class="p-4 text-center border border-dashed rounded-2xl border-neutral-300 dark:border-neutral-600"
    >
      <div class="text-2xl font-bold text-neutral-900 dark:text-neutral-100">
        5+
      </div>
      <div class="mt-1 text-xs text-neutral-500 dark:text-neutral-400">
        开源项目
      </div>
    </div>
    <div
      class="p-4 text-center border border-dashed rounded-2xl border-neutral-300 dark:border-neutral-600"
    >
      <div class="text-2xl font-bold text-neutral-900 dark:text-neutral-100">
        10K+
      </div>
      <div class="mt-1 text-xs text-neutral-500 dark:text-neutral-400">
        全网 Stars
      </div>
    </div>
  </div>

  <Separator text="折腾的一些项目" />
  <Projects />
  <Separator text="瞎写的一些文章" />
  <Writings />
</Layout>
